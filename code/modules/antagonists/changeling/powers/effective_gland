/datum/action/changeling/enhanced_chemical_synthesis
	name = "Enhanced Chemical Synthesis"
	desc = "We optimize our internal chemistry to produce reagents at an accelerated rate."
	helptext = "Permanently increases chemical regeneration rate by 50%."
	button_icon_state = "enhanced_chem"
	power_type = CHANGELING_PURCHASABLE_POWER
	dna_cost = 2
	var/recharge_multiplier = 1.5

/datum/action/changeling/enhanced_chemical_synthesis/on_purchase(mob/user)
	. = ..()
	var/datum/antagonist/changeling/changeling = user.mind?.has_antag_datum(/datum/antagonist/changeling)
	if(changeling)
		changeling.chem_recharge_rate *= recharge_multiplier

/datum/action/changeling/enhanced_chemical_synthesis/Remove(mob/user)
	var/datum/antagonist/changeling/changeling = user.mind?.has_antag_datum(/datum/antagonist/changeling)
	if(changeling)
		changeling.chem_recharge_rate /= recharge_multiplier
	. = ..()
