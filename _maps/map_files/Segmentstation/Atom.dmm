"tEL" = (
/obj/structure/window/reinforced,
/obj/structure/table/reinforced,
/obj/machinery/atmospherics/pipe/simple/visible/green{
	desc = "Труба проводящая газ по фильтрам, где он перемещается в камеры хранения";
	dir = 4;
	name = "Труба фильтрации"
	},
/obj/effect/decal/cleanable/dirt,
/obj/item/paper{
	name = "Руководство по фильтрации газов";
	info = "<station>  <logo> <h3> Руководство по системе фильрации </h3><hr> В следствии того что на станции было решено сэкономить для увелечения бюджетов на востановление станции, закупатся мы решили у компании P.A.T. Данная компания поставляет газы в смешаном виде, по этой причине вы должны отфильтровывать нужные вам газы самостоятельно.Это делается следующим образом: Выбираем на панели газов 1 из трёх скраберов (не вентиляцию) и выбираем для фильтрации всего 1 газ на трубу. Дале врубаем насос и камера к которой ведёт труба начинает наполнятся. Нужно подметить, что вы должны проследить за тем чтобы в баках не происходило смешивания газов (иногда такие действия приводят к засорам)"
	},
/turf/simulated/floor/plasteel{
	icon_state = "dark"
	},
/area/atmos)
