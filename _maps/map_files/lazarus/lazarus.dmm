"aFg" = (
/obj/effect/decal/cleanable/dust,
/obj/structure/bed/old,
/obj/item/paper{
	desc = "Мятый лист бумаги в пыли и мазуте.";
	info = "НЕ ЗАБЫТЬ<hr>Последнюю партию больше через старую дорогу не тащим. Патрули начали ходить дальше на север, не знаю что они там вынюхивают, но лучше не светиться<br><br>Новый маршрут: старая тропа - озеро - метеостанция - восточный сектор<br><br>На метеостанции людей почти не бывает. Если дверь закрыта — ждать до следующего окна связи.<br><br>Груз прятать не возле станции, а дальше по тропе. В прошлый раз кто-то полез в старый склад и едва не нашёл следы.<br><br>И еще:<br>Если начинается дождь - не выходить<br>В прошлый раз один из наших решил, что это обычная гроза. Через десять минут кожа на руках пошла пятнами, а металлический контейнер пришлось выбросить.<br>Не знаю, что там творится с атмосферой, но метеорологи явно что-то скрывают.<br><br>К.";
	name = "Записка"
	},
/turf/simulated/floor/wood/fancy/oak,
/area/planetoid/caves/underground_lake)
