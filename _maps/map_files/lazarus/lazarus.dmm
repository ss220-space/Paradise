"uVz" = (
/obj/effect/decal/cleanable/cobweb,
/obj/item/paper{
	desc = "Лист бумаги в пыли.";
	info = "Дата 15 Месяц 9 Год 2568 <hr>Нас было шестеро на этом наблюдательном посту, включая меня.<br><br> Двое из них предали нас. Они направили оружие против собственных товарищей. Я не знаю, по какой причине.<br><br> Мы вступили в бой прямо внутри базы. Трое солдат погибли. Я пытался удерживать позицию и ждать помощи, но после взрыва главный выход оказался завален. Связи с внешним миром больше нет. <br><br> Предатели сбежали. Я не знаю живы они или нет <br><br> Нас оставили здесь.<br><br> Пути наружу больше нет. Надежды на помощь тоже нет. <br><br> Я последний в живых. Я не стану ждать смерти в этой темноте. <br><br> Если кто-нибудь найдёт эту запись, пусть помнит: погибшие здесь выполнили свой долг. <br><br> Прощайте.";
	name = "Записка";
	pixel_y = -8
	},
/turf/simulated/floor/carpet/red,
/area/planetoid/caves)
