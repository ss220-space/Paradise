"eXQ" = (
/obj/structure/table,
/obj/effect/decal/cleanable/dust,
/obj/item/folder/blue{
	pixel_x = 6;
	pixel_y = 6
	},
/obj/item/paper{
	desc = "Лист бумаги в идеальном состоянии";
	info = "<h1>МЕТЕОРОЛОГИЧЕСКАЯ СТАНЦИЯ #1-LV624<br>ОТЧЕТ О СОСТОЯНИИ АТМОСФЕРНЫХ ОСАДКОВ</h1><hr>Дата: 21.06.2567<br>Ответственный наблюдатель: Джордж Уиззерсмит<br><br>За последний период наблюдений в северо-восточном секторе неоднократно зарегистрированы осадки с повышенной кислотностью.<br><br>Обычный показатель pH дождевой воды составляет 5,4-5,8. Во время отдельных эпизодов показатель снижался до 3,1-3,6<br><br>Анализ проб выявил повышенное содержание сульфат- и нитрат-ионов. Предполагается, что явление связано с присутствием в атмосфере аэрозольных соединений неизвестного происхождения.<br><br>Несмотря на повышенную кислотность осадков, заметного ущерба местной флоре не обнаружено. Растительность региона демонстрирует высокую устойчивость к подобным условиям, предположительно вследствие длительной адаптации.<br><br>Наибольшую опасность осадки представляют для человека, металлических конструкций и оборудования.<br><br>Рекомендуется избегать нахождения под открытым небом во время осадков с pH ниже 3,5.<br><br><br>Примечание:Причина периодического повышения кислотности атмосферы пока не установлена. Продолжить сбор проб.";
	name = "Отчет метеостанции - кислотные осадки"
	},
/turf/simulated/floor/plating,
/area/planetoid/lazarus/abandoned_building/weather_station)
