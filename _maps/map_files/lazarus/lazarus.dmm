/obj/structure/table/wood,
/obj/item/paper{
	desc = "Мятый лист бумаги.";
	info = "Илаясу<hr> Салли так и не вернул деньги за те две бутылки виски. Ты к нему слишком добр, Илаяс! Этот кретин просто бухает за наш счет, судя по слухам он должен денег чуть ли не половине инженеров. Вот увидишь, его арестуют и вышлют к черту отсюда еще к завершению строительства. <br><br> Ах да, на этот раз он еще и стойку нам заблевал, а после сбежал пъяный от охраны куда-то в сторону джунглей за церковью. Пока не вернет 8 сотен - больше этому уроду не наливай! <br><br><br><br> - Боб.";
	name = "Записка"
	},
/obj/item/radio/intercom/directional/east,
