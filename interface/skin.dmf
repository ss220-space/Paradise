		text = "Эмоция"
		command = ".winset \"mebutton.is-checked=true ? input.command=\"!Эмоция' \\\"\" : input.command=\"\"mebutton.is-checked=true ? saybutton.is-checked=false\"\"mebutton.is-checked=true ? oocbutton.is-checked=false\"\"mebutton.is-checked=true ? whisperbutton.is-checked=false\""
