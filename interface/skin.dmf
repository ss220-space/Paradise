	elem "saybutton"
		type = BUTTON
		pos = 0,0
		size = 40x25
		anchor1 = 0,0
		anchor2 = 25,100
		font-size = 4
		border = line
		saved-params = "is-checked"
		text = "Сказать"
		command = ".winset \"saybutton.is-checked=true ? input.command=\"!Сказать \\\"\" : input.command=\"\"saybutton.is-checked=true ? mebutton.is-checked=false\"\"saybutton.is-checked=true ? oocbutton.is-checked=false\"\"saybutton.is-checked=true ? whisperbutton.is-checked=false\""
